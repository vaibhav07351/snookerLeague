rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLeagueMember(leagueId) {
      return signedIn()
        && leagueId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueIds;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      match /players/{playerId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      match /races/{raceId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
