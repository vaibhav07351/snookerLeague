rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userCityId() {
      return get(/databases/$(database)/documents/playerProfiles/$(request.auth.uid)).data.cityId;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids
        || (
          resource.data.kind == 'city'
          && exists(/databases/$(database)/documents/playerProfiles/$(request.auth.uid))
          && userCityId() == resource.data.cityId
          && request.auth.uid in request.resource.data.memberUids
        )
      );

      match /players/{playerId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
        allow delete: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/leagues/$(leagueId)).data.createdByUid;
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      match /races/{raceId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /playerProfiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /challenges/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow delete: if signedIn() && request.auth.uid == resource.data.fromUid;
    }

    match /lookingPosts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdByUid == request.auth.uid;
    }

    match /directoryListings/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdByUid == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
