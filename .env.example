# Firebase web app config (free Spark plan). Leave blank to use local demo mode.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth web client ID (Firebase console → Authentication → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Force local AsyncStorage even if Firebase env is set (no cloud sync)
EXPO_PUBLIC_USE_LOCAL_DATA=true

# Google users: data stays local-first and syncs to Firestore when online.
# Deploy rules: firebase deploy --only firestore:rules (or paste firestore.rules in console).
