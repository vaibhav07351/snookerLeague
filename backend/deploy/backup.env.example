# Copy to backup.env (next to backup.sh) on the VM and fill in:  chmod 600 backup.env
# Never commit the real backup.env.

# File holding the backup passphrase (one line). Create it once on the VM:
#   openssl rand -base64 48 > /home/ubuntu/.snookit-backup-pass
#   chmod 600 /home/ubuntu/.snookit-backup-pass
# ALSO save the passphrase in your password manager: if the VM is lost, the off-VM backups
# can only be opened with it.
BACKUP_PASSPHRASE_FILE=/home/ubuntu/.snookit-backup-pass

# rclone remote and folder for the off-VM copy (set up with `rclone config`), for example
# an Oracle Object Storage or Backblaze B2 bucket. Blank = no off-VM copy (a warning is logged).
BACKUP_REMOTE=

# Days of backups kept on the VM and on the remote. The public delete-account page promises
# that backups holding a deleted account are gone within 7 days, so keep this at 7 or less.
BACKUP_KEEP_DAYS=7

# Where the encrypted files are written on the VM.
BACKUP_DIR=/home/ubuntu/backups
