# Copy to .env on the server and fill in. Never commit the real .env.
# Generate secrets on the server, e.g.:  openssl rand -base64 48

# Docker network IronCoach's Caddy is on (check: docker network ls)
EDGE_NETWORK=ironcoach-backend_ironcoach

POSTGRES_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-at-least-32-bytes-long-random

# The WEB OAuth client id (the app asks Google for tokens with it), and the Android client id(s).
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_IDS=yyyy.apps.googleusercontent.com

SENTRY_DSN=
MIN_APP_VERSION=0.0.0

# Shown on the public /delete-account page for people who can't open the app (optional).
SUPPORT_EMAIL=

# Expo push access token, only if "enhanced push security" is on in the Expo project (optional).
EXPO_PUSH_ACCESS_TOKEN=

# This server's public address, used in share links and link previews (optional).
PUBLIC_BASE_URL=https://snookit.duckdns.org

# Android App Links: SHA-256 fingerprint(s) of the app signing certificate, comma separated
# (Play Console > Setup > App signing, or `eas credentials`). Optional; blank disables.
ANDROID_CERT_SHA256=
