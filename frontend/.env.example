# Snookit API (Go backend). Leave blank to keep everyone in local demo mode.
EXPO_PUBLIC_API_URL=https://snookit.duckdns.org

# Google OAuth web client ID (Google Cloud console -> APIs & Services -> Credentials).
# Must match GOOGLE_WEB_CLIENT_ID on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public web URL (EAS Hosting production): Google OAuth redirect and league invite links
EXPO_PUBLIC_WEB_ORIGIN=https://snookit.expo.app

# Force local storage even if the API is set (no cloud sync)
EXPO_PUBLIC_USE_LOCAL_DATA=false

# Google users: data stays local-first and syncs to the API when online.
